diff --git a/ui-commit.c b/ui-commit.c
index 972e9bc..9c1b9f1 100644
--- a/ui-commit.c
+++ b/ui-commit.c
@@ -9,12 +9,70 @@
 #define USE_THE_REPOSITORY_VARIABLE
 
 #include "cgit.h"
+#include "gpg-interface.h"
 #include "ui-commit.h"
 #include "html.h"
 #include "ui-shared.h"
 #include "ui-diff.h"
 #include "ui-log.h"
 
+static void print_commit_signature(struct commit *commit)
+{
+	struct signature_check signature = { 0 };
+	const char *class = "unverified";
+	const char *label = "Unverified";
+	int verified;
+
+	check_commit_signature(commit, &signature);
+	if (!signature.payload)
+		goto out;
+
+	verified = signature.result == 'G' && signature.signer;
+	if (verified) {
+		class = "verified";
+		label = "Verified";
+	} else if (signature.result == 'B') {
+		class = "invalid";
+		label = "Invalid";
+	}
+
+	html("<tr><th>signature</th><td colspan='2'>");
+	if (verified)
+		html("<button type='button' class='signature verified' popovertarget='commit-signature-details'>Verified</button>");
+	else
+		htmlf("<span class='signature %s'>%s</span>", class, label);
+	if (signature.signer) {
+		html(" ");
+		html_txt(signature.signer);
+	} else if (signature.fingerprint) {
+		html(" ");
+		html_txt(signature.fingerprint);
+	}
+	if (verified) {
+		html("<div class='signature-popover' id='commit-signature-details' popover>");
+		html("<button type='button' class='signature-close' popovertarget='commit-signature-details' popovertargetaction='hide' aria-label='Close'>&times;</button>");
+		html("<p class='signature-summary'>This commit was signed with a verified signature.</p><dl>");
+		html("<dt>Signer</dt><dd>");
+		html_txt(signature.signer);
+		html("</dd>");
+		if (signature.key) {
+			html("<dt>Signing key</dt><dd>");
+			html_txt(signature.key);
+			html("</dd>");
+		}
+		if (signature.fingerprint) {
+			html("<dt>Fingerprint</dt><dd>");
+			html_txt(signature.fingerprint);
+			html("</dd>");
+		}
+		html("</dl></div>");
+	}
+	html("</td></tr>\n");
+
+out:
+	signature_check_clear(&signature);
+}
+
 void cgit_print_commit(char *hex, const char *prefix)
 {
 	struct commit *commit, *parent;
@@ -73,6 +131,7 @@ void cgit_print_commit(char *hex, const char *prefix)
 	html_txt(show_date(info->committer_date, info->committer_tz,
 				cgit_date_mode(DATE_ISO8601)));
 	html("</td></tr>\n");
+	print_commit_signature(commit);
 	html("<tr><th>commit</th><td colspan='2' class='oid'>");
 	tmp = oid_to_hex(&commit->object.oid);
 	cgit_commit_link(tmp, NULL, NULL, ctx.qry.head, tmp, prefix);
